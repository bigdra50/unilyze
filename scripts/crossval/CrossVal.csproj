<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <!-- NU1903: Microsoft.Build.Tasks.Core 17.7.2 (transitive via Workspaces.MSBuild 4.12) has a known
         advisory. This is a local analysis-only harness, never shipped or run in CI; MSBuildLocator
         loads the installed SDK's MSBuild at runtime, so the vulnerable assembly is not actually used. -->
    <NoWarn>$(NoWarn);NU1903</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Build.Locator" Version="1.11.2" />
    <!-- MSBL001 (Build.Locator >= 1.9 enforces this): MSBuild assemblies must never flow to the
         output directory — MSBuildLocator loads them from the located SDK at run time, and a
         copied Microsoft.Build.Framework would collide with it. Workspaces.MSBuild 5.3 pulls it
         transitively with runtime assets, so pin an explicit reference that strips them. -->
    <PackageReference Include="Microsoft.Build.Framework" Version="18.9.6" ExcludeAssets="runtime" PrivateAssets="all" />
    <PackageReference Include="Microsoft.CodeAnalysis.CSharp.Workspaces" Version="5.6.0" />
    <PackageReference Include="Microsoft.CodeAnalysis.Workspaces.MSBuild" Version="5.6.0" />
    <PackageReference Include="Microsoft.CodeAnalysis.AnalyzerUtilities" Version="5.6.0" />
  </ItemGroup>

</Project>
