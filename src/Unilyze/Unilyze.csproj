<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFrameworks>net8.0;net9.0;net10.0</TargetFrameworks>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <PackAsTool>true</PackAsTool>
    <ToolCommandName>unilyze</ToolCommandName>
    <PackageOutputPath>./nupkg</PackageOutputPath>
    <MinVerTagPrefix>v</MinVerTagPrefix>
    <Authors>bigdra50</Authors>
    <Description>CLI tool to analyze Unity project .asmdef and C# source code with Roslyn, generating dependency graphs and code quality metrics.</Description>
    <PackageProjectUrl>https://github.com/bigdra50/unilyze</PackageProjectUrl>
    <RepositoryUrl>https://github.com/bigdra50/unilyze</RepositoryUrl>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PackageIcon>icon.png</PackageIcon>
    <PackageTags>unity;roslyn;static-analysis;code-quality;dependency-graph</PackageTags>
  </PropertyGroup>
  <ItemGroup>
    <InternalsVisibleTo Include="Unilyze.Tests" />
    <InternalsVisibleTo Include="DocsGen" />
  </ItemGroup>
  <ItemGroup>
    <None Include="..\..\README.md" Pack="true" PackagePath="\" />
    <None Include="..\..\THIRD-PARTY-NOTICES.txt" Pack="true" PackagePath="\" />
    <None Include="..\..\assets\icon.png" Pack="true" PackagePath="\" />
  </ItemGroup>
  <ItemGroup>
    <EmbeddedResource Include="Skills\**\*" LogicalName="Skills/%(RecursiveDir)%(Filename)%(Extension)" />
    <EmbeddedResource Include="$(IntermediateOutputPath)viewer.html" LogicalName="Unilyze.Templates.viewer.html" Visible="false" />
    <EmbeddedResource Include="Templates\trend.html" LogicalName="Unilyze.Templates.trend.html" />
    <!-- serve-only same-origin assets (CSP script-src 'self'): raw viewer JS/CSS + serve client + page shell -->
    <EmbeddedResource Include="Templates\viewer\main.js" LogicalName="Unilyze.Templates.viewer.main.js" />
    <EmbeddedResource Include="Templates\viewer\styles.css" LogicalName="Unilyze.Templates.viewer.styles.css" />
    <EmbeddedResource Include="Templates\serve\index.html" LogicalName="Unilyze.Templates.serve.index.html" />
    <EmbeddedResource Include="Templates\serve\serve-client.js" LogicalName="Unilyze.Templates.serve.serve-client.js" />
    <!-- Bundled vendor JS (offline graph): cytoscape.min.js v3.30.4 SHA256 1bb5340e549511e111b31e5684872c949ad33d40ea5dba0ad8e7d90c62c7b3b9 MIT -->
    <EmbeddedResource Include="Templates\vendor\cytoscape.min.js" LogicalName="Unilyze.Templates.vendor.cytoscape.min.js" />
    <!-- dagre.min.js v0.8.5 SHA256 62eb9787ccfdbdf4148d4d99d31dbf9ee4770eafee81e637d759b52aac22cd51 MIT -->
    <EmbeddedResource Include="Templates\vendor\dagre.min.js" LogicalName="Unilyze.Templates.vendor.dagre.min.js" />
    <!-- cytoscape-dagre.js v2.5.0 SHA256 bf70fe402991dcbff33e05a7e4a5271c78020bb75e85d1c80ab7538e4157112e MIT -->
    <EmbeddedResource Include="Templates\vendor\cytoscape-dagre.js" LogicalName="Unilyze.Templates.vendor.cytoscape-dagre.js" />
    <!-- elk.bundled.js (elkjs) v0.9.3 SHA256 b0745abd7f23cd91690a1587e377edbe19fd7233c783300290936720546216d4 EPL-2.0; serve-only same-origin ELK (main-thread, CSP-compatible) -->
    <EmbeddedResource Include="Templates\vendor\elk.bundled.js" LogicalName="Unilyze.Templates.vendor.elk.bundled.js" />
    <EmbeddedResource Include="Resources\*.txt" LogicalName="Unilyze.Resources.%(Filename)%(Extension)" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.CodeAnalysis.CSharp" Version="5.6.0" />
    <PackageReference Include="MinVer" Version="7.0.0" PrivateAssets="All" />
  </ItemGroup>
  <Target Name="UnilyzeAssemblyVersion" AfterTargets="MinVer">
    <PropertyGroup>
      <AssemblyVersion>$(MinVerMajor).$(MinVerMinor).$(MinVerPatch).0</AssemblyVersion>
    </PropertyGroup>
  </Target>

  <Target Name="CombineViewerTemplate" BeforeTargets="PrepareForBuild"
          Inputs="Templates/viewer/index.html;Templates/viewer/styles.css;Templates/viewer/main.js;Templates/viewer/combine.py"
          Outputs="$(IntermediateOutputPath)viewer.html">
    <MakeDir Directories="$(IntermediateOutputPath)" />
    <Exec Command="python3 &quot;$(MSBuildProjectDirectory)/Templates/viewer/combine.py&quot; &quot;$(IntermediateOutputPath)viewer.html&quot;" />
  </Target>

</Project>
